# Backend API base URL (Express backend, includes /api)
NEXT_PUBLIC_API_URL=https://rentnest-backend-one.vercel.app/api

# Public URL of this frontend (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WhatsApp chat number, international format without "+".
# Leave empty to use the demo placeholder (+1 212 555 0100).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ImgBB API key (server-side only, used by /api/upload)
IMGBB_API_KEY=

# Read-only observer demo account shown on the login page. These values are
# intentionally public: the account can view dashboards but can't change anything.
NEXT_PUBLIC_OBSERVER_EMAIL=observer@rentnest.dev
NEXT_PUBLIC_OBSERVER_PASSWORD=Observer-Demo-1
