# ---------- App (set these in Vercel) ----------
# Backend API base URL, ending in /api. Every API call uses it.
NEXT_PUBLIC_API_URL=https://rentnest-backend-one.vercel.app/api

# Public URL of this site, no trailing slash. Used for canonical links, the
# sitemap, robots, Open Graph and JSON-LD. The build warns when it's missing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WhatsApp chat number, international format without "+".
# Leave empty to use the demo placeholder (+1 212 555 0100).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Read-only observer demo account shown on the login page. These values are
# intentionally public: the account can view dashboards but can't change anything.
NEXT_PUBLIC_OBSERVER_EMAIL=observer@rentnest.dev
NEXT_PUBLIC_OBSERVER_PASSWORD=Observer-Demo-1

# ImgBB API key (server-side only, used by /api/upload). Never prefix it with NEXT_PUBLIC_.
IMGBB_API_KEY=

# ---------- Playwright tests only (not needed in Vercel) ----------
# E2E_BASE_URL=           # test a deployed site instead of a local build
# E2E_PORT=               # port for the local build (default 3100)
# E2E_API_URL=            # API for test setup/cleanup (default NEXT_PUBLIC_API_URL)
# E2E_RENTAL_DECISION=    # "approve" instead of the default reject
# E2E_LANDLORD_EMAIL=     # private landlord login; tests needing it skip without
# E2E_LANDLORD_PASSWORD=
# E2E_ADMIN_EMAIL=        # private admin login; tests needing it skip without
# E2E_ADMIN_PASSWORD=
